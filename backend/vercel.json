{
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run-all",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/auto-briefing",
      "schedule": "0 12 * * *"
    }
  ]
}
